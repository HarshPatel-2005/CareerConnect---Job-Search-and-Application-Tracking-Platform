{
    "name": "CareerConnect",
    "version": "0.0.1",
    "main": "index.js",
    "engines": {
        "node": ">=22.5.0"
    },
    "scripts": {
        "db:up": "docker compose up -d",
        "db:down": "docker compose down",
        "db:reset": "docker compose down -v",
        "start": "node src/api/server.js",
        "dev": "docker compose up -d && node --watch src/api/server.js",
        "test": "jest --detectOpenHandles --runInBand"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "dotenv": "^18.0.4",
        "express": "^5.2.1",
        "multer": "^2.4.0",
        "mysql2": "^3.24.4"
    },
    "devDependencies": {
        "jest": "^30.5.2",
        "supertest": "^7.3.0"
    }
}

{
    "name": "CareerConnect",
    "version": "0.0.1",
    "main": "index.js",
    "engines": {
        "node": ">=22.5.0"
    },
    "scripts": {
        "db:up": "docker compose up -d",
        "db:migrate": "node db/migrate.js",
        "db:down": "docker compose down",
        "db:reset": "docker compose down -v && rmdir -R .\\uploads\\resumes\\",
        "start": "node src/api/server.js",
        "dev": "docker compose up -d && node --watch src/api/server.js",
        "test": "jest --detectOpenHandles --runInBand",
        "test:applications:db": "node tests/integration/applications.mysql.js",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "dotenv": "^18.0.6",
        "express": "^5.3.0",
        "jsonwebtoken": "^9.0.3",
        "mammoth": "^1.13.0",
        "multer": "^2.5.0",
        "mysql2": "^3.24.6",
        "ollama": "^0.6.4",
        "pdf-parse": "^2.4.5"
    },
    "jest": {
        "testMatch": [
            "**/tests/*.test.js"
        ]
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "jest": "^30.5.2",
        "supertest": "^7.3.0"
    }
}
